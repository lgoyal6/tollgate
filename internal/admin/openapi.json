{
  "openapi": "3.1.0",
  "info": {
    "title": "Tollgate management API",
    "version": "1",
    "description": "The gateway's management surface: tenants, their routes, and the per-teammate API keys that spend the shared upstream credential. Every operation except the console requires the ADMIN_TOKEN bearer token; the surface does not exist at all when that token is unset. Paths are relative to the mount prefix /_admin. Every response body on this surface is a JSON object. Failures carry a single `error` string and nothing else: no table, column or constraint name, no driver text, no host the gateway failed to reach. A path this document does not declare answers 404 in that same envelope; a declared path addressed with a method it does not declare answers 405, with an Allow header naming exactly the methods listed for that path here. This document is checked against the running router by internal/admin/surface_test.go and internal/admin/contract_test.go, in both directions."
  },
  "servers": [
    {
      "url": "/_admin"
    }
  ],
  "components": {
    "securitySchemes": {
      "adminToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Tenant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "enabled",
          "algorithm",
          "rate",
          "burst",
          "window_ms",
          "limit",
          "routes",
          "active_keys"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "token_bucket",
              "sliding_window"
            ]
          },
          "rate": {
            "type": "number"
          },
          "burst": {
            "type": "integer"
          },
          "window_ms": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "routes": {
            "type": "integer",
            "minimum": 0
          },
          "active_keys": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Route": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tenant_id",
          "path_prefix",
          "upstream",
          "strip_prefix",
          "timeout_ms",
          "retry_max",
          "credential_set"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "tenant_id": {
            "type": "string"
          },
          "path_prefix": {
            "type": "string"
          },
          "upstream": {
            "type": "string"
          },
          "strip_prefix": {
            "type": "boolean"
          },
          "timeout_ms": {
            "type": "integer",
            "format": "int64"
          },
          "retry_max": {
            "type": "integer"
          },
          "required_scope": {
            "type": "string"
          },
          "credential_from": {
            "type": "string"
          },
          "credential_set": {
            "type": "boolean"
          }
        }
      },
      "Key": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tenant_id",
          "scopes",
          "status",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "grace",
              "revoked"
            ]
          },
          "grace_until": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TenantCounters": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requests",
          "admitted",
          "limited",
          "server_errors"
        ],
        "properties": {
          "requests": {
            "type": "number"
          },
          "admitted": {
            "type": "number"
          },
          "limited": {
            "type": "number"
          },
          "server_errors": {
            "type": "number"
          }
        }
      },
      "Overview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tenants",
          "routes",
          "keys",
          "usage"
        ],
        "properties": {
          "tenants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tenant"
            }
          },
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Route"
            }
          },
          "keys": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Key"
            },
            "description": "Key identity and lifecycle only. secret_hash is never serialised here."
          },
          "usage": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TenantCounters"
            }
          }
        }
      },
      "IssuedKey": {
        "type": "object",
        "additionalProperties": false,
        "description": "The only response that carries a secret. The plaintext is returned once at issue time and is not recoverable afterwards; only its SHA-256 is stored.",
        "required": [
          "key_id",
          "key",
          "tenant",
          "note"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "tenant": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "RotatedKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_id",
          "key",
          "tenant",
          "replaced",
          "grace_until",
          "note"
        ],
        "properties": {
          "key_id": {
            "type": "string",
            "minLength": 1
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "tenant": {
            "type": "string",
            "minLength": 1
          },
          "replaced": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "grace_until": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreatedTenant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "tenant"
        ],
        "properties": {
          "status": {
            "const": "created"
          },
          "tenant": {
            "type": "string"
          }
        }
      },
      "UpdatedTenant": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "tenant"
        ],
        "properties": {
          "status": {
            "const": "updated"
          },
          "tenant": {
            "type": "string"
          }
        }
      },
      "CreatedRoute": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "tenant",
          "prefix"
        ],
        "properties": {
          "status": {
            "const": "created"
          },
          "tenant": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          }
        }
      },
      "RevokedKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "key_id"
        ],
        "properties": {
          "status": {
            "const": "revoked"
          },
          "key_id": {
            "type": "string"
          }
        }
      },
      "DeletedRoute": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "route_id"
        ],
        "properties": {
          "status": {
            "const": "deleted"
          },
          "route_id": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
  },
  "security": [
    {
      "adminToken": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "operationId": "getConsole",
        "summary": "The single-page management console.",
        "description": "HTML rather than JSON, and the one operation with no security requirement: the page ships no data and holds no token. The operator pastes the admin token into it at runtime and it is kept in memory only, never written to disk or into a URL.",
        "security": [],
        "responses": {
          "200": {
            "description": "the console page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "405": {
            "description": "the console is GET only; Allow names the methods this path serves",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/overview": {
      "get": {
        "operationId": "getOverview",
        "summary": "Tenants, routes, keys and per-replica usage counters in one round trip.",
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "401": {
            "description": "missing or wrong admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "the path exists but does not serve this method; Allow names the ones it does",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenants": {
      "post": {
        "operationId": "createTenant",
        "summary": "Create a tenant and its rate limit policy.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "id"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[^\\u0000]*$"
                  },
                  "enabled": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "algorithm": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "token_bucket",
                      "sliding_window",
                      null
                    ]
                  },
                  "rate": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "burst": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "window_ms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9223372036854
                  },
                  "limit": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedTenant"
                }
              }
            }
          },
          "400": {
            "description": "unparseable body, unknown field, missing id, or a policy the schema rejects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or wrong admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "the path exists but does not serve this method; Allow names the ones it does",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "the gateway could not complete the request; the reason is in its log, not in this body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "a tenant with that id already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenants/{id}": {
      "put": {
        "operationId": "updateTenant",
        "summary": "Replace a tenant's name, enabled flag and full rate limit policy.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[^\\u0000]*$"
                  },
                  "enabled": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "algorithm": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "token_bucket",
                      "sliding_window",
                      null
                    ]
                  },
                  "rate": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0
                  },
                  "burst": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  },
                  "window_ms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9223372036854
                  },
                  "limit": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9223372036854775807
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdatedTenant"
                }
              }
            }
          },
          "400": {
            "description": "unparseable body, unknown field, or an invalid policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or wrong admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "no such tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "the path exists but does not serve this method; Allow names the ones it does",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "the gateway could not complete the request; the reason is in its log, not in this body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenants/{id}/keys": {
      "post": {
        "operationId": "issueKey",
        "summary": "Issue a new API key for the tenant. The plaintext is shown once.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scopes": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "type": "string",
                      "pattern": "^[^\\u0000]*$"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IssuedKey"
                }
              }
            }
          },
          "400": {
            "description": "unknown field, unparseable body, or no such tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or wrong admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "the path exists but does not serve this method; Allow names the ones it does",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "the CSPRNG failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "no such tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tenants/{id}/routes": {
      "post": {
        "operationId": "addRoute",
        "summary": "Point a path prefix owned by this tenant at an upstream.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path_prefix",
                  "upstream"
                ],
                "additionalProperties": false,
                "properties": {
                  "path_prefix": {
                    "type": "string",
                    "pattern": "^/[^\\u0000]*$",
                    "minLength": 1
                  },
                  "upstream": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[^\\u0000]*$"
                  },
                  "strip_prefix": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "timeout_ms": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 9223372036854
                  },
                  "retry_max": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 5
                  },
                  "required_scope": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[^\\u0000]*$"
                  },
                  "auth_header": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Header the upstream credential is sent in.",
                    "pattern": "^[^\\u0000]*$"
                  },
                  "auth_env": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "NAME of the gateway environment variable holding the credential. The value never leaves the gateway process and is never stored.",
                    "pattern": "^[^\\u0000]*$"
                  },
                  "auth_prefix": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[^\\u0000]*$"
                  }
                },
                "dependentRequired": {
                  "auth_header": [
                    "auth_env"
                  ],
                  "auth_env": [
                    "auth_header"
                  ]
                },
                "oneOf": [
                  {
                    "properties": {
                      "auth_header": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 0
                      },
                      "auth_env": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "maxLength": 0
                      }
                    }
                  },
                  {
                    "required": [
                      "auth_header",
                      "auth_env"
                    ],
                    "properties": {
                      "auth_header": {
                        "type": "string",
                        "minLength": 1
                      },
                      "auth_env": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatedRoute"
                }
              }
            }
          },
          "400": {
            "description": "unparseable body, unknown field, or a route the schema rejects",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or wrong admin token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "the path exists but does not serve this method; Allow names the ones it does",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "the gateway could not complete the request; the reason is in its log, not in this body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "no such tenant",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "that tenant already has the route",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/keys/{id}/rotate": {
      "post": {
        "operationId": "rotateKey",
        "summary": "Move a key into a grace window and issue its replacement, atomically.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
